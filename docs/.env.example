NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY=""
TYPESENSE_ADMIN_API_KEY=""

# Next.js - public URL
NEXT_PUBLIC_URL="http://192.168.8.41:4000"

# Better Auth
BETTER_AUTH_URL="http://192.168.8.41:4000"
BETTER_AUTH_SECRET=""
