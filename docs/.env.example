GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Local embedded Turso database file (not a Turso Cloud URL)
# Generate migrations with `pnpm --filter docs db:generate`; apply them before starting Next.js.
# Apply migrations with `pnpm --filter docs db:migrate`.
DATABASE_PATH=./auth.db

